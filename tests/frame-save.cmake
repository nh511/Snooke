set(base "${OUTPUT}/frame-${CONFIG}")
file(REMOVE_RECURSE "${base}")
file(MAKE_DIRECTORY "${base}")
execute_process(COMMAND "${TEST}" --make "${SOURCE}/data/bundles/six-pocket-engineering.bundle" "${SOURCE}/data/baselines/center/initial.snapshot" "${SOURCE}/data/baselines/center/center.input" "${base}/save0.frame" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "frame make failed")
endif()
execute_process(COMMAND "${FRAME}" --continue "${base}/save0.frame" "${SOURCE}/data/baselines/center/center.input" "${base}/save1.frame" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "first process continuation failed")
endif()
execute_process(COMMAND "${FRAME}" --continue "${base}/save1.frame" "${SOURCE}/data/baselines/center/center.input" "${base}/save2.frame" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "second process continuation failed")
endif()
execute_process(COMMAND "${TEST}" "${base}/save2.frame" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "frame verification failed")
endif()
