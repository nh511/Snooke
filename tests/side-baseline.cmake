string(RANDOM LENGTH 10 ALPHABET 0123456789 suffix)
set(out "${OUTPUT}/side-${CONFIG}-${suffix}")
foreach(mode IN ITEMS left right)
    execute_process(COMMAND "${SIMULATE}" "${SOURCE}/data/bundles/six-pocket-engineering.bundle"
        "${SOURCE}/data/baselines/${mode}/initial.snapshot" "${SOURCE}/data/baselines/${mode}/center.input" "${out}/${mode}"
        RESULT_VARIABLE code OUTPUT_VARIABLE log ERROR_VARIABLE error)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "side simulation failed: ${log}; ${error}")
    endif()
    execute_process(COMMAND "${NODE}" "${SOURCE}/tools/compare.cjs"
        "${SOURCE}/data/baselines/${mode}/trajectory.csv" "${out}/${mode}/trajectory.csv" 1e-9 RESULT_VARIABLE code)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "side baseline mismatch")
    endif()
    execute_process(COMMAND "${REPLAY}" "${out}/${mode}/record.shot" RESULT_VARIABLE code)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "side physical replay mismatch")
    endif()
endforeach()
execute_process(COMMAND "${NODE}" "${SOURCE}/tests/side-baseline.cjs" "${out}/left" "${out}/right" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "side-spin mirror assertion failed")
endif()
