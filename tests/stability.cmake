execute_process(COMMAND "${TOOL}" "${SOURCE}/data/bundles/six-pocket-engineering.bundle" 50 424242 "${OUTPUT}/stability-${CONFIG}.json" RESULT_VARIABLE code OUTPUT_VARIABLE log ERROR_VARIABLE error TIMEOUT 180)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "stability run failed: ${log}; ${error}")
endif()
file(READ "${OUTPUT}/stability-${CONFIG}.json" json)
string(JSON shot_count GET "${json}" shots)
string(JSON fault_count GET "${json}" faults)
string(JSON memory_growth GET "${json}" memoryGrowth)
if(NOT shot_count EQUAL 50 OR NOT fault_count EQUAL 0 OR memory_growth GREATER 10485760)
  message(FATAL_ERROR "invalid stability report")
endif()
