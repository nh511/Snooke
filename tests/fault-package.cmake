set(out "${OUTPUT}/fault-package-${CONFIG}")
file(REMOVE_RECURSE "${out}")
execute_process(COMMAND "${PACKAGE}" "${OUTPUT}/physics-fault.txt" "${SOURCE}/data/validation/center.input" "${out}" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "fault package creation failed")
endif()
foreach(file IN ITEMS fault.txt checkpoint.snapshot physics.bundle shot.input fault.log README.txt manifest.txt)
  if(NOT EXISTS "${out}/${file}")
    message(FATAL_ERROR "fault package missing ${file}")
  endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${OUTPUT}/physics-fault.txt" "${out}/fault.txt" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "fault bytes changed in package")
endif()
execute_process(COMMAND "${REPLAY}" "${out}/fault.txt" WORKING_DIRECTORY "${out}" RESULT_VARIABLE code OUTPUT_VARIABLE log ERROR_VARIABLE error)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "package-only replay failed: ${log}; ${error}")
endif()
file(READ "${out}/fault.log" text)
if(NOT text MATCHES "code=VelocityExplosion" OR NOT text MATCHES "step=0")
  message(FATAL_ERROR "fault log missing diagnosis")
endif()
