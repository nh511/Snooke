function(checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "Command failed (${code}): ${ARGV}; ${out}; ${err}")
    endif()
    message(STATUS "${out}")
endfunction()
set(base "${OUTPUT}/shot-entry-${CONFIG}")
file(MAKE_DIRECTORY "${base}")
checked("${STRIKE}" --files "${SOURCE}/data/default.snooker" "${SOURCE}/data/validation/stationary.snapshot" "${SOURCE}/data/validation/center.input" --output "${base}/files.snapshot")
checked("${STRIKE}" --record "${SOURCE}/data/validation/center-entry.shot" --output "${base}/record.snapshot")
checked("${CMAKE_COMMAND}" -E compare_files "${base}/files.snapshot" "${base}/record.snapshot")
foreach(entry IN ITEMS files record)
    checked("${SINGLE}" "${SOURCE}/data/default.snooker" "${base}/${entry}.snapshot" "${base}/${entry}.csv" "${base}/${entry}-final.snapshot")
endforeach()
checked("${CMAKE_COMMAND}" -E compare_files "${base}/files.csv" "${base}/record.csv")
checked("${CMAKE_COMMAND}" -E compare_files "${base}/files-final.snapshot" "${base}/record-final.snapshot")
